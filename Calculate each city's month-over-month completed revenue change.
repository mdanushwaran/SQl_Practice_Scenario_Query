-- Scenario: Calculate each city's month-over-month completed revenue change.
-- Requirements:
-- - Calculate total completed revenue for each city and month.
-- - Use LAG() to get the previous month's revenue for the same city.
-- - Display City, Revenue_Month, Total_Revenue, Previous_Revenue, and Revenue_Change.
-- - Calculate Revenue_Change as current revenue minus previous revenue.
-- - Sort by city and month.
-- Hint: Use two CTEs: one to aggregate monthly revenue, and another to calculate LAG() with PARTITION BY City.


Answer Query 


with Monthly_Revenue as(
select City , month(Order_Date) as Revenue_Month , 
sum(Revenue) as Total_Revenue from Sales_data
where Order_Status = 'Completed'
group by City, Revenue_Month),

Pervious_value as(
select City , Revenue_Month , Total_Revenue ,
lag(Total_Revenue) over(partition by City order by Revenue_Month) as Pervious_Revenue from Monthly_Revenue )

select City , Revenue_Month , Total_Revenue , Pervious_Revenue ,
Total_Revenue - Pervious_Revenue as Revenue_Change 
from Pervious_value
order by City , Revenue_Month;
